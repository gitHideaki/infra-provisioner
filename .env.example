# Netbird
NETBIRD_API_URL=https://netbird.example.com
NETBIRD_SERVICE_TOKEN=nbp_xxx
NETBIRD_PROVISIONING_GROUP_ID=xxxxxx

# Proxmox
PROXMOX_HOST=https://proxmox.example.com:8006
PROXMOX_TOKEN_ID=user@pam!tokenname
PROXMOX_TOKEN_SECRET=xxxxxxxx
PROXMOX_NODE=pve
PROXMOX_VXLAN_ZONE=vxlan1
PROXMOX_USER_REALM=pve
PROXMOX_USER_ROLE=PVEVMUser
PROXMOX_SDN_ROLE=PVESDNUser
# ユーザーごとのサブネット第1・2オクテット（id=N → {base}.N.0/24）
PROXMOX_SUBNET_BASE=10.0

# App
DB_PATH=/data/app.db
SYNC_INTERVAL_SECONDS=300

# Token rotation
# Netbird Service Account のユーザー ID（Netbird UI: Settings > Service Accounts で確認）
NETBIRD_SERVICE_USER_ID=xxxxxx
# トークンを何日ごとにローテーションするか（発行するトークンの有効期限はこの値 + 1 日）
TOKEN_ROTATION_DAYS=6
